# Copy to app/.env. Only EXPO_PUBLIC_* variables are bundled into the app, so NEVER put secrets here.
# API base URL. If unset, the app derives it: web -> http://<page host>:4000/api, device -> <Expo dev host>:4000/api, Android emulator -> 10.0.2.2:4000/api
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api
