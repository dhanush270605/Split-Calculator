# Copy to server/.env and set real values. Never commit .env.
# (Load with your shell / process manager; e.g. PowerShell: $env:JWT_SECRET="..."; npm start)

NODE_ENV=development
PORT=4000

# REQUIRED in production: long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# SQLite database file and uploaded evidence directory (use a persistent disk in production)
DB_PATH=./data/splitcalc.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=5242880

# Comma-separated allowed browser origins (web build). "*" is fine for local dev only.
CORS_ORIGINS=*

# bcrypt cost factor (10-12 recommended)
BCRYPT_COST=10

# First real admin (used only by `npm run create-admin`)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
